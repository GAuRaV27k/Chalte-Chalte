# TimeLens AI Frontend Environment Configuration

# Base URL for the TimeLens AI generation & inference backend API service
# Leave empty during development to run the interactive client-side simulation demo mode.
# When a real backend is running (e.g. FastAPI / PyTorch / ComfyUI server), set:
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Optional client telemetry or logging flags
VITE_ENABLE_DEBUG_TELEMETRY=false
